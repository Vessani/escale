  generator client {
    provider = "prisma-client-js"
  }

  datasource db {
    provider = "postgresql"
  }


  enum StatusIntegracao {
    ATIVO
    INATIVO
    PENDENTE
  }

  enum StatusViagem {
    CRIADA      
    ALOCADA     
    INICIADA
    RETORNANDO
    POSTERGADA
    FINALIZADA  
    CANCELADA 
  }

  enum Turno {
    MANHA
    NOITE
  }

  // Função do motorista na operação — decide onde ele pode entrar na escala
  // (ver lib/services/tipo-motorista.ts, fonte única dessas regras):
  // - MOTORISTA: viaja e entra na sugestão automática;
  // - TREINAMENTO: só como acompanhante, nunca principal;
  // - INSTRUTOR: viaja (principal ou acompanhante), mas só por alocação
  //   manual — acompanha outro motorista ou um em treinamento;
  // - INTERNO: fica no apoio da operação (render motorista, levar frota pra
  //   lavar...), fora da sugestão; alocação manual quando precisar. Não
  //   confundir com o código de jornada 10 "Interno" do calendário, que é um
  //   dia pontual, não a função;
  // - ENCHEDOR: não faz viagem.
  enum TipoMotorista {
    MOTORISTA
    TREINAMENTO
    INSTRUTOR
    INTERNO
    ENCHEDOR
  }

  enum AcaoAuditoria {
    CRIACAO
    ATUALIZACAO
    EXCLUSAO
  }

  // Gases transportados pela transportadora — usado pra restringir qual
  // motorista pode ser alocado a qual viagem (ver motoristaEhCompativel em
  // alocacao.service.ts) e pra sinalizar quando a frota escolhida não é a
  // dedicada a esse produto (ver calcularAvisoFrotaProduto).
  // Manutenção de frota (ver model Manutencao).
  enum VeiculoManutencao {
    CAVALO
    CARRETA
  }

  enum TipoManutencao {
    PREVENTIVA
    CORRETIVA
  }

  // Plano da preventiva, do mais simples (A) ao mais completo (D).
  enum NivelPreventiva {
    A
    B
    C
    D
  }

  // Quem responde pelo tempo parado — separa o relatório de disponibilidade.
  enum ResponsavelManutencao {
    WHITE_MARTINS
    RITMO
  }

  enum TipoProduto {
    CO2
    NITROGENIO
    ARGONIO
    BIOMETANO
    OXIGENIO
  }

  // Cadastro global de clientes (compartilhado entre filiais — um cliente
  // como AMBEV pode ser atendido por mais de uma). exigeIntegracao substitui
  // a lista fixa que existia no código (CLIENTES_COM_INTEGRACAO_OBRIGATORIA em
  // alocacao.service.ts): quando true, uma entrega cujo SAP Code (Entrega.sapcode)
  // bata com o numeroSap deste cliente exige que o motorista tenha uma
  // Integracao ativa e válida com ele. Sem FK pra Entrega.sapcode/Integracao.cliente
  // de propósito — ambos continuam VarChar livres; este cadastro só passa a
  // ser a fonte de verdade nos formulários novos.
  model Cliente {
    id              Int       @id @default(autoincrement())
    nome            String    @db.VarChar(100)
    // SAP Code — identificador estável do cliente no SAP, usado como chave de
    // correspondência com Entrega.sapcode pra decidir Viagem.integracaoExigida
    // (o nome do cliente é digitado de forma inconsistente na entrega, o SAP
    // Code não). Sem @@unique aqui de propósito, mesmo padrão de
    // Frota.(cavalo,carreta): a unicidade só vale entre clientes ativos,
    // aplicada por índice único parcial na migration.
    numeroSap       String    @db.VarChar(20)
    exigeIntegracao Boolean   @default(false)

    criadoEm        DateTime  @default(now())
    atualizadoEm    DateTime  @updatedAt
    deletadoEm      DateTime?

    @@index([nome])
    @@index([numeroSap])
  }

  // Cada filial opera de forma isolada: motoristas, viagens, frotas e o
  // quadro de observações são todos escopados por filialId, sem visão
  // cruzada entre filiais (nem para ADMIN — só SUPERADMIN, que não pertence
  // a nenhuma, gerencia o cadastro de filiais/usuários).
  model Filial {
    id       Int      @id @default(autoincrement())
    nome     String   @db.VarChar(100)
    criadoEm DateTime @default(now())

    // Último dia coberto pelo Relatório de Jornada importado (o dia mais
    // recente de qualquer motorista do lote). Até esse dia o relatório é a
    // verdade: viagem do Escale num dia em que o relatório não mostra o
    // motorista trabalhando não conta como trabalho (ver
    // viagemDesmentidaPeloRelatorio em lib/services/alocacao/disponibilidade.ts).
    relatorioJornadaAte DateTime? @db.Date

    usuarios         Usuario[]
    motoristas       Motorista[]
    viagens          Viagem[]
    frotas           Frota[]
    manutencoes      Manutencao[]
    quadroObservacao QuadroObservacao?
  }

  model Viagem {
    id                Int          @id @default(autoincrement())

    // Preenchido quando o Relatório de Jornada cobre os dias desta viagem e
    // não mostra o motorista trabalhando — a viagem provavelmente não
    // aconteceu (ou foi com outro motorista). Ela deixa de contar pro
    // descanso; o aviso é pra alguém conferir e cancelar/corrigir. Ver
    // recalcularAvisosInterjornada.
    avisoRelatorioJornada String?
    // Sem @unique aqui de propósito: a unicidade real só vale entre viagens
    // ativas (deletadoEm IS NULL) da mesma filial, e é aplicada por um índice
    // único parcial escrito à mão na migration — do contrário, um número
    // reaproveitado depois de deletar a viagem original ficaria bloqueado
    // para sempre (ou colidiria entre filiais diferentes).
    numViagem         String       @db.VarChar(12)

    carreta           String       @db.VarChar(7)
    cavalo            String       @db.VarChar(7)
    tanque            String       @db.VarChar(10)


    inicioPrevisto    DateTime     @db.Timestamp(6)
    fimPrevisto       DateTime     @db.Timestamp(6)
    turno             Turno
    diasViagem        Int

    // Nulo pra viagens criadas antes desse campo existir — o formulário passa
    // a exigir a partir de agora (ver validation/viagens.ts), mas o histórico
    // não é retroativamente preenchido. Usado como produtoExigido em
    // motoristaEhCompativel (bloqueia motorista sem essa autorização) e como
    // base do aviso de frota incompatível (calcularAvisoFrotaProduto).
    // TODO: migrar histórico (preencher o produto das viagens antigas) e
    // tornar esta coluna NOT NULL — checar antes `SELECT count(*) FROM
    // "Viagem" WHERE produto IS NULL` e garantir que todo motorista ativo
    // tem produtosAutorizados não vazio, senão ele some das sugestões.
    produto           TipoProduto?

    integracaoExigida String?      @db.VarChar(50)
    status            StatusViagem @default(CRIADA)

    // Marca uma viagem incluída depois que a programação do dia/período já
    // saiu pra operação — não é um status (convive com qualquer status do
    // fluxo normal), só uma sinalização pros relatórios e pra tela de
    // viagens saberem que ela não fazia parte do planejamento original.
    viagemExtra       Boolean      @default(false)

    horarioRealSaida  DateTime?    @db.Timestamp(6)
    motivoAtraso      String?      @db.VarChar(200)
    avisoInterjornada String?      @db.VarChar(200)
    avisoFrotaIndisponivel String? @db.VarChar(200)
    avisoFrotaProdutoIncompativel String? @db.VarChar(200)
    // Gravado só na transição pra CANCELADA (ver atualizarStatusViagemService) — usado
    // pra decidir até quando ela some do dashboard (visível no dia do cancelamento).
    canceladoEm       DateTime?    @db.Timestamp(6)
    // Gravado só na transição pra FINALIZADA — libera o motorista a partir daí
    // (o descanso de 11h/35h conta desde aqui, ver fimEfetivoViagem).
    finalizadoEm      DateTime?    @db.Timestamp(6)

    motoristaId       Int?
    motorista         Motorista?   @relation("MotoristaPrincipal", fields: [motoristaId], references: [id])

    // Segundo motorista (ex: acompanhante/aprendiz em treinamento) — não passa
    // pela checagem de compatibilidade (turno/dias/integração) do principal.
    motoristaAcompanhanteId Int?
    motoristaAcompanhante   Motorista? @relation("MotoristaAcompanhante", fields: [motoristaAcompanhanteId], references: [id])

    filialId          Int
    filial            Filial       @relation(fields: [filialId], references: [id])

    criadoEm          DateTime     @default(now())
    atualizadoEm      DateTime     @updatedAt
    deletadoEm        DateTime?    // Para o Soft Delete

    entregas          Entrega[]

    // Preenchidos pelo motorista no acesso dele: km do
    // hodômetro na saída e na chegada.
    kmInicial         Int?
    kmFinal           Int?
    despesas          DespesaViagem[]
    // Informado pelo motorista no celular; vazio = sem problema (ou resolvido).
    // Preenchido, aparece em vermelho na linha da viagem no Dashboard/TV.
    problemaMecanico   String?   @db.VarChar(300)
    problemaMecanicoEm DateTime?
    trocas             TrocaMotorista[]

    @@index([motoristaId])
    @@index([motoristaAcompanhanteId])
    @@index([status])
    @@index([inicioPrevisto, fimPrevisto])
    @@index([cavalo])
    @@index([carreta])
    @@index([numViagem])
    @@index([filialId])
    // Lista paginada da Gestão de Viagens e Dashboard: filial + período,
    // ordenado por início (ver buscarViagensPaginadas/buscarViagensDoDashboard).
    @@index([filialId, inicioPrevisto])
  }

  // Bloco único de recados gerais da operação (ex: "frota 2024 com problema no
  // freio"), editado por qualquer despachante direto no rodapé do Dashboard.
  // Um registro por filial (upsert por filialId).
  model QuadroObservacao {
    id           Int      @id @default(autoincrement())
    texto        String   @db.Text
    atualizadoEm DateTime @updatedAt

    filialId     Int      @unique
    filial       Filial   @relation(fields: [filialId], references: [id])
  }

  // Cadastro de conjuntos (cavalo + carreta — pra truck, os dois com o mesmo
  // número) com disponibilidade. disponivelEm é atualizado automaticamente
  // pelo fim previsto da viagem mais recente pra aquela dupla (ver
  // frota.service.ts), e pode ser corrigido à mão no cadastro (ex: liberação
  // de manutenção). Nulo ou no passado = disponível agora; no futuro = em
  // manutenção/ocupado até aquela data/hora.
  model Frota {
    id           Int       @id @default(autoincrement())
    cavalo       String    @db.VarChar(7)
    carreta      String    @db.VarChar(7)
    disponivelEm DateTime? @db.Timestamp(6)
    // DESCONTINUADO — substituído pelas manutenções agendadas (model
    // Manutencao). A migration 20261001010000 converteu quem estava marcado
    // numa manutenção em aberto. Mantido só pra não quebrar a versão anterior
    // durante o deploy; remover numa migration futura. Nenhum código lê.
    emManutencao Boolean   @default(false)

    // Produto que esse conjunto é dedicado a transportar — um só por
    // conjunto (diferente do motorista, que pode ter vários autorizados),
    // pra refletir contaminação cruzada entre gases. Nulo pros conjuntos já
    // cadastrados antes desse campo existir. Só gera aviso, nunca bloqueia
    // (ver calcularAvisoFrotaProduto em frota.service.ts) — cavalo/carreta na
    // viagem é texto livre, pode nem ter frota cadastrada ainda.
    tipoProduto  TipoProduto?

    filialId     Int
    filial       Filial    @relation(fields: [filialId], references: [id])

    criadoEm     DateTime  @default(now())
    atualizadoEm DateTime  @updatedAt
    deletadoEm   DateTime?

    // Sem @@unique aqui de propósito: a unicidade real só vale entre
    // conjuntos ativos (deletadoEm IS NULL) da mesma filial, e é aplicada por
    // um índice único parcial escrito à mão na migration — do contrário,
    // cavalo/carreta reaproveitados depois de deletar o conjunto original
    // ficariam bloqueados para sempre (ou colidiriam entre filiais). Por isso
    // mesmo, nenhum código deve usar findUnique/upsert pela dupla
    // cavalo+carreta (não existe mais um WhereUniqueInput pra isso) — sempre
    // findFirst filtrando deletadoEm: null e filialId.
    @@index([cavalo, carreta])
    @@index([cavalo])
    @@index([carreta])
    @@index([filialId])
  }

  model Entrega {
    id           Int          @id @default(autoincrement())
    viagemId     Int
    
    dataEntrega  DateTime     @db.Timestamp(6)
    cliente      String       @db.VarChar(100)
    cidade       String       @db.VarChar(25)
    uf           String       @db.VarChar(5)
    
    kg           Decimal      @db.Decimal(10, 2)
    m3           Decimal      @db.Decimal(10, 2)
    
    obs          String       @db.VarChar(50)
    sapcode      String       @db.VarChar(12)
    codewhite    String       @db.VarChar(12)
    
    criadoEm     DateTime     @default(now())
    atualizadoEm DateTime     @updatedAt

    viagem       Viagem       @relation(fields: [viagemId], references: [id], onDelete: Cascade, onUpdate: NoAction)
    chegada      ChegadaEntrega?

    // O Postgres não cria índice pra chave estrangeira sozinho — sem isto,
    // carregar as entregas de qualquer viagem varria a tabela inteira.
    @@index([viagemId])
  }

  model Motorista {
    id              Int          @id @default(autoincrement())
    nome            String       @db.VarChar(50)
    seva            Int

    // Nulo pros motoristas já cadastrados antes desse campo existir — não é
    // retroativamente preenchido, mas o formulário passa a exigir a partir de
    // agora (validado por dígito verificador, ver lib/utils/cpf.ts). @unique
    // padrão do Postgres permite múltiplos NULL, então isso não bloqueia os
    // motoristas sem CPF entre si.
    cpf             String?      @unique @db.VarChar(11)

    diasTrabalhados Int


    turno           Turno

    // Substitui o antigo `liberado` (false = TREINAMENTO) — ver enum TipoMotorista.
    tipo            TipoMotorista @default(MOTORISTA)

    // Gases que esse motorista está autorizado a transportar — pode ter mais
    // de um. Vazio ([]) pros motoristas já cadastrados antes desse campo
    // existir, o que os torna incompatíveis com QUALQUER viagem que exija um
    // produto (ver motoristaEhCompativel em alocacao.service.ts) até serem
    // editados e receberem pelo menos uma autorização.
    produtosAutorizados TipoProduto[] @default([])

    // Último registro do Relatório Sintético de Jornada importado pra esse
    // motorista (busca por `seva` = Matrícula do relatório) — ver
    // jornada-relatorio.service.ts. O mais recente entre todas as jornadas
    // do lote de import (o relatório traz vários turnos por motorista; cada
    // um também vira uma linha em RegistroJornada — ver abaixo).
    jornadaRelatorioInicio DateTime? @db.Timestamp(6)
    jornadaRelatorioFim    DateTime? @db.Timestamp(6)
    jornadaRelatorioDia    DateTime? @db.Date

    filialId        Int
    filial          Filial       @relation(fields: [filialId], references: [id])

    criadoEm        DateTime     @default(now())
    atualizadoEm    DateTime     @updatedAt
    deletadoEm      DateTime?

    integracao      Integracao[]
    viagens         Viagem[]     @relation("MotoristaPrincipal")
    viagensComoAcompanhante Viagem[] @relation("MotoristaAcompanhante")
    trocasSaiu      TrocaMotorista[] @relation("TrocaAnterior")
    trocasEntrou    TrocaMotorista[] @relation("TrocaNovo")
    registrosJornada RegistroJornada[]
    /** Acesso do próprio motorista (área "Minhas viagens"), se o despacho criou. */
    acesso          Usuario?

    @@index([seva])
    @@index([filialId])
  }

  // Histórico de jornada por dia. diasTrabalhados no Motorista continua sendo
  // um cache do registro de hoje; este model é a fonte de verdade do
  // calendário, permitindo editar um dia específico sem afetar os outros.
  model RegistroJornada {
    id           Int       @id @default(autoincrement())
    motoristaId  Int
    data         DateTime  @db.Date
    codigo       Int

    // Horário real de início/fim desse dia, vindo do Relatório Sintético de
    // Jornada (ver jornada-relatorio.service.ts) — nulo pra linhas criadas por
    // edição manual do calendário, cadastro de motorista ou reconciliação de
    // folga; só o import de jornada preenche.
    inicioJornada DateTime? @db.Timestamp(6)
    fimJornada    DateTime? @db.Timestamp(6)

    // "Dias Sem Folga" real do relatório (já corrigido das batidas unidas),
    // sem o limite de 6 do `codigo` — 7 ou mais = folga estourada (ver
    // lib/services/dias-sem-folga.ts e Relatórios → Dias sem folga). Nulo
    // em linha que não veio do relatório.
    diasSemFolga  Int?

    criadoEm     DateTime  @default(now())
    atualizadoEm DateTime  @updatedAt

    motorista    Motorista @relation(fields: [motoristaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    @@unique([motoristaId, data])
  }

  model Integracao {
    id           Int              @id @default(autoincrement())
    motoristaId  Int?
    
    cliente      String           @db.VarChar(50)         
    status       StatusIntegracao
    dataValidade DateTime         @db.Date
    
    criadoEm     DateTime         @default(now())
    atualizadoEm DateTime         @updatedAt

    motorista    Motorista?       @relation(fields: [motoristaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

    // Mesmo motivo do índice de Entrega.viagemId: integrações são sempre
    // carregadas por motorista.
    @@index([motoristaId])
  }


  model Usuario {
    id            String    @id @default(cuid())
    nome          String?
    email         String?   @unique
    senha         String?
    // Ex: SUPERADMIN (sem filial — gerencia filiais/usuários), ADMIN, DESPACHANTE
    role          String    @default("DESPACHANTE")
    emailVerified DateTime?
    image         String?

    // false = desativado: não entra mais, e a sessão aberta cai no próximo
    // acesso (ver callbacks.jwt em lib/auth.ts). Nunca apagar usuário — a
    // auditoria referencia quem fez cada coisa.
    ativo         Boolean   @default(true)

    // Nulo só pra SUPERADMIN — ADMIN/DESPACHANTE sempre têm filial (regra
    // aplicada na action de criar usuário, não dá pra expressar isso no schema).
    filialId      Int?
    filial        Filial?   @relation(fields: [filialId], references: [id])

    // Só pro papel MOTORISTA: o motorista do cadastro dono deste acesso
    // (login = SEVA + PIN, ver autenticarMotorista). Um acesso por motorista.
    motoristaId   Int?       @unique
    motorista     Motorista? @relation(fields: [motoristaId], references: [id])

    // Sobe a cada PIN novo: sessão aberta com versão antiga cai na hora
    // (celular perdido/trocado). Ver revalidarToken.
    versaoSessao  Int        @default(0)

    accounts      Account[]
    sessions      Session[]
  }

  // Tentativas de login que falharam — base do limite de tentativas (ver
  // lib/services/login.service.ts). Guardadas no banco e não em memória
  // porque na Vercel cada requisição pode cair numa instância diferente.
  // Linhas antigas são apagadas sozinhas a cada nova falha.
  model TentativaLogin {
    id       Int      @id @default(autoincrement())
    email    String   @db.VarChar(200)
    ip       String?  @db.VarChar(100)
    criadoEm DateTime @default(now())

    @@index([email, criadoEm])
    @@index([ip, criadoEm])
  }

  model Account {
    id                 String  @id @default(cuid())
    userId             String
    type               String
    provider           String
    providerAccountId  String
    refresh_token      String?  @db.Text
    access_token       String?  @db.Text
    expires_at         Int?
    token_type         String?
    scope              String?
    id_token           String?  @db.Text
    session_state      String?

    user Usuario @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
  }

  model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         Usuario  @relation(fields: [userId], references: [id], onDelete: Cascade)
  }

  model VerificationToken {
    identifier String
    token      String   @unique
    expires    DateTime

    @@unique([identifier, token])
  }

  // Log genérico de mudanças em qualquer entidade mutável — a versão
  // consultável do quadro branco que a operação apagava todo dia. Gravado
  // sempre dentro da mesma transação da escrita real (ver registrarAuditoria
  // em auditoria.service.ts), nunca separado dela.
  model RegistroAuditoria {
    id          Int           @id @default(autoincrement())

    // Nome do model afetado ("Viagem", "Motorista", "Frota", "Cliente",
    // "Usuario", "QuadroObservacao", "RegistroJornada") — texto livre, não
    // FK, de propósito: o log tem que sobreviver independente do ciclo de
    // vida das entidades que audita.
    entidade    String        @db.VarChar(40)
    // Sempre String — unifica Usuario.id (cuid) com os demais (Int, via
    // String(id)). QuadroObservacao (uma linha por filial, sem id próprio)
    // usa String(filialId).
    entidadeId  String        @db.VarChar(30)
    acao        AcaoAuditoria

    // Snapshot completo (via serializeData) antes/depois da mutação — null
    // em antes (CRIACAO). NUNCA deve conter senha/hash de Usuario (redigido
    // no call site, não aqui).
    antes       Json?
    depois      Json?

    usuarioId   String?
    // Denormalizado: o log deve mostrar o nome de quando a ação aconteceu.
    usuarioNome String?

    filialId    Int?
    criadoEm    DateTime      @default(now())

    // Histórico de um registro específico (painel "Histórico" na edição).
    @@index([entidade, entidadeId, criadoEm])
    // Feed do dia por filial (tela /historico).
    @@index([filialId, criadoEm])
  }
  // Manutenção de um veículo — o cavalo OU a carreta, não o conjunto: o
  // cavalo pode parar sozinho enquanto a carreta segue com outro. Identifica
  // o veículo pelo código (mesmo texto de Viagem.cavalo/carreta), porque a
  // viagem não tem FK pra frota. O conjunto fica indisponível se qualquer um
  // dos dois estiver em manutenção.
  //
  // Período efetivo: começa no início real (ou no previsto, se ninguém
  // registrou) e só termina no fim real — passou da previsão sem concluir,
  // continua parado (ver lib/services/manutencao-regras.ts).
  model Manutencao {
    id             Int                   @id @default(autoincrement())
    filialId       Int
    filial         Filial                @relation(fields: [filialId], references: [id])

    veiculo        VeiculoManutencao
    codigo         String                @db.VarChar(7)

    tipo           TipoManutencao
    // Só pra preventiva.
    nivel          NivelPreventiva?
    responsavel    ResponsavelManutencao
    descricao      String?               @db.VarChar(500)

    inicioPrevisto DateTime              @db.Timestamp(6)
    // Nulo = sem previsão de término (fica parado até concluir).
    fimPrevisto    DateTime?             @db.Timestamp(6)
    inicioReal     DateTime?             @db.Timestamp(6)
    fimReal        DateTime?             @db.Timestamp(6)

    criadoEm       DateTime              @default(now())
    atualizadoEm   DateTime              @updatedAt
    deletadoEm     DateTime?

    @@index([filialId, veiculo, codigo])
    @@index([filialId, inicioPrevisto])
  }

  enum TipoDespesaViagem {
    PEDAGIO
    PERNOITE
  }

  enum TipoMedicao {
    MANOMETRO
    BALANCA
  }

  // Chegada do motorista em cada cliente (uma por entrega): km, hora e a
  // medição do que foi descarregado. Ver lib/services/descarga.ts pra conta.
  model ChegadaEntrega {
    id                Int          @id @default(autoincrement())
    entregaId         Int          @unique
    entrega           Entrega      @relation(fields: [entregaId], references: [id], onDelete: Cascade)

    km                Int
    chegadaEm         DateTime
    // Nulo no biometano (lê em polegadas e m³, sem conversão).
    medicao           TipoMedicao?
    // Nível do tanque do caminhão (balança: kg; manômetro: leitura; biometano: m³).
    nivelInicial      Decimal      @db.Decimal(12, 3)
    nivelFinal        Decimal      @db.Decimal(12, 3)
    // Biometano: as mesmas leituras em polegadas.
    polInicial        Decimal?     @db.Decimal(10, 2)
    polFinal          Decimal?     @db.Decimal(10, 2)
    // Conversão usada (manômetro: a do cliente, informada; balança: a do produto).
    fator             Decimal?     @db.Decimal(10, 4)
    totalDescarregado Decimal      @db.Decimal(14, 3)

    usuarioId         String?
    registradoEm      DateTime     @default(now())
    atualizadoEm      DateTime     @updatedAt
  }

  // Pedágio/pernoite lançado durante a viagem (pelo motorista, no acesso
  // dele). Vários lançamentos por viagem; valor em centavos pra não ter
  // erro de arredondamento. Excluir = soft delete (fica no histórico).
  model DespesaViagem {
    id            Int               @id @default(autoincrement())
    viagemId      Int
    viagem        Viagem            @relation(fields: [viagemId], references: [id])
    tipo          TipoDespesaViagem
    valorCentavos Int
    registradoEm  DateTime          @default(now())
    // Quem lançou (Usuario.id) — texto, não FK, como na auditoria.
    usuarioId     String?
    deletadoEm    DateTime?

    @@index([viagemId])
  }

  // Troca de motorista no meio da viagem: quem entregou, quem assumiu, onde
  // e com quantos km. A viagem passa pro novo (Viagem.motoristaId).
  model TrocaMotorista {
    id                  Int       @id @default(autoincrement())
    viagemId            Int
    viagem              Viagem    @relation(fields: [viagemId], references: [id])
    motoristaAnteriorId Int
    motoristaAnterior   Motorista @relation("TrocaAnterior", fields: [motoristaAnteriorId], references: [id])
    motoristaNovoId     Int
    motoristaNovo       Motorista @relation("TrocaNovo", fields: [motoristaNovoId], references: [id])
    km                  Int
    trocadoEm           DateTime
    local               String    @db.VarChar(100)
    motivo              String    @db.VarChar(200)
    usuarioId           String?
    registradoEm        DateTime  @default(now())

    @@index([viagemId])
  }

